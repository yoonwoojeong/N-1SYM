/-- Chirality. -/
def Γ7 : Mat16 := Γ 0 * Γ 1 * Γ 2 * Γ 3 * Γ 4 * Γ 5

/-- Charge conjugation. -/
def chargeC6 : Mat16 := Γ 5

set_option maxRecDepth 1000000

theorem clifford6 : ∀ a b : Fin 6,
    Γ a * Γ b + Γ b * Γ a = (if a = b then 2 * ηg a else 0) • (1 : Mat16) := by decide +kernel

theorem Γ7_sq : Γ7 * Γ7 = 1 := by decide +kernel
theorem Γ7_anticomm : ∀ a, Γ7 * Γ a = -(Γ a * Γ7) := by decide +kernel

/-! The quaternionic structure. -/

theorem qI_sq : qI * qI = -1 := by decide +kernel
theorem qJ_sq : qJ * qJ = -1 := by decide +kernel
theorem qI_mul_qJ : qI * qJ = qK := by decide +kernel
theorem qJ_mul_qI : qJ * qI = -qK := by decide +kernel
theorem qI_comm : ∀ a, qI * Γ a = Γ a * qI := by decide +kernel
theorem qJ_comm : ∀ a, qJ * Γ a = Γ a * qJ := by decide +kernel

/-! Symmetry of the bilinears `ψ̄ q Γ^{(p)} χ`: rank 0 and rank 1. -/

theorem C6_transpose : chargeC6.transpose = -chargeC6 := by decide +kernel
theorem C6Γ_transpose : ∀ a, (chargeC6 * Γ a).transpose = chargeC6 * Γ a := by decide +kernel
theorem C6qI_transpose : (chargeC6 * qI).transpose = chargeC6 * qI := by decide +kernel
theorem C6qJ_transpose : (chargeC6 * qJ).transpose = chargeC6 * qJ := by decide +kernel
theorem C6qK_transpose : (chargeC6 * qK).transpose = chargeC6 * qK := by decide +kernel
theorem C6qIΓ_transpose : ∀ a, (chargeC6 * qI * Γ a).transpose = -(chargeC6 * qI * Γ a) := by
  decide +kernel
theorem C6qJΓ_transpose : ∀ a, (chargeC6 * qJ * Γ a).transpose = -(chargeC6 * qJ * Γ a) := by
  decide +kernel

end SYM6
